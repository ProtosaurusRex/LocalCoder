# Model provider: "ollama" (default, local) or "anthropic" (hosted)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING=true
# Context window in tokens: 8192 for 4 GB VRAM; see README for larger GPUs
OLLAMA_NUM_CTX=8192

# Anthropic (only if LLM_PROVIDER=anthropic; also: uv add langchain-anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Agent limits
WORKSPACE_ROOT=./workspace
MAX_STEPS=25
COMMAND_TIMEOUT_S=60

# Documentation tools
DOC_SOURCES=doc_sources.json
DOCS_MAX_CHARS=2000
